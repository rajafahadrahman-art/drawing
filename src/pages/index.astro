---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/search/SearchPanel.astro';
import TutorialCard from '../components/tutorials/TutorialCard.astro';
import FaqSection from '../components/common/FaqSection.astro';
import { SITE, CATEGORY_META, LEARN_GUIDES } from '../data/site';
import { getCollection } from 'astro:content';
import '../styles/homepage.css';

const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);
const bySlug = (slug: string) => tutorials.find((t) => t.data.slug === slug);

const flower = bySlug('flower-drawing');
const featuredSupport = ['rose-drawing', 'cat-drawing', 'butterfly-drawing', 'tree-drawing']
  .map(bySlug)
  .filter(Boolean);
const easy = tutorials.filter((t) => t.data.difficulty === 'beginner').slice(0, 6);
const latest = [...tutorials].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 6);
const worksheetSamples = ['flower-drawing', 'rose-drawing', 'cat-drawing', 'butterfly-drawing'].map(bySlug).filter(Boolean);

const homeCategories = [
  { id: 'flower-drawings', label: 'Flowers', tone: 'mint', blurb: 'Blooms, petals, and stems' },
  { id: 'animal-drawings', label: 'Animals', tone: 'peach', blurb: 'Cats, dogs, horses, and more' },
  { id: 'bird-drawings', label: 'Birds', tone: 'yellow', blurb: 'Owls, songbirds, and wings' },
  { id: 'nature-drawings', label: 'Nature', tone: 'white', blurb: 'Trees, clouds, and landscapes' },
  { id: 'vehicle-drawings', label: 'Vehicles', tone: 'mint', blurb: 'Cars, planes, and trains' },
  { id: 'fantasy-drawings', label: 'Fantasy', tone: 'peach', blurb: 'Dragons and unicorns' },
];

const chips = [
  { label: 'Flower', href: '/flower-drawing/' },
  { label: 'Rose', href: '/rose-drawing/' },
  { label: 'Cat', href: '/cat-drawing/' },
  { label: 'Dog', href: '/dog-drawing/' },
  { label: 'Butterfly', href: '/butterfly-drawing/' },
  { label: 'Tree', href: '/tree-drawing/' },
];

const homepageFaqs = [
  {
    question: 'What kind of drawing lessons does Drawinging offer?',
    answer:
      'Drawinging publishes step-by-step drawing tutorials organized by category, with beginner-friendly lessons, printable worksheets, and clear construction guidance.',
  },
  {
    question: 'Do I need special art supplies?',
    answer:
      'Most lessons only need pencil, eraser, and paper. Some tutorials suggest optional colored pencils or markers once the line drawing is complete.',
  },
  {
    question: 'Are the worksheets free to download?',
    answer:
      'Yes. Priority tutorials include free PDF and SVG practice worksheets you can print and reuse.',
  },
  {
    question: 'How should beginners start?',
    answer:
      'Begin with Easy Drawings or a fundamentals guide such as basic shapes, then practise one subject tutorial with its worksheet.',
  },
  {
    question: 'Is Drawinging an online drawing tool?',
    answer:
      'No. Drawinging is an educational content site focused on tutorials, categories, and printable practice sheets—not a canvas or drawing app.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.domain,
    logo: `${SITE.domain}/brand/logo.svg`,
    email: SITE.email,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.domain,
    description: SITE.description,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE.domain}/search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
];
---

<BaseLayout
  title="Drawinging — Step-by-Step Drawing Tutorials & Worksheets"
  description={SITE.description}
  canonical={`${SITE.domain}/`}
  ogImage={`${SITE.domain}/images/homepage/drawing-tutorials-hero.webp`}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow">Clear lessons. Real practice.</p>
        <h1>Learn to Draw, One Clear Step at a Time</h1>
        <p class="hero__lede">
          Drawinging brings together beginner-friendly tutorials, visual drawing steps, organized categories, and
          printable worksheets to help you practise with confidence.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/drawing-tutorials/">Browse Drawing Tutorials</a>
          <a class="btn btn--secondary" href="/worksheets/">Download Free Worksheets</a>
        </div>
      </div>
      <div class="hero__visual">
        <img
          src="/images/homepage/drawing-tutorials-hero.webp"
          alt="drawing tutorials and printable worksheets"
          title="drawing tutorials and printable worksheets"
          width="1200"
          height="900"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="search-band">
    <div class="container">
      <div class="search-panel">
        <SearchPanel id="home-search" large />
        <div class="search-chips" aria-label="Popular quick links">
          {chips.map((chip) => <a class="chip" href={chip.href}>{chip.label}</a>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Popular</p>
        <h2 class="section__title">Popular guides</h2>
        <p class="section__intro">Start with clear, high-demand lessons built for calm practice.</p>
      </div>
      <div class="featured-layout">
        <div>{flower && <TutorialCard tutorial={flower} featured />}</div>
        <div class="featured-side">
          {featuredSupport.map((t) => <TutorialCard tutorial={t} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--surface" id="categories">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Browse</p>
        <h2 class="section__title">Browse categories</h2>
        <p class="section__intro">Find lessons by subject family, then open a full tutorial when you are ready.</p>
      </div>
      <div class="cat-grid">
        {
          homeCategories.map((tile) => (
            <a class={`cat-tile cat-tile--${tile.tone}`} href={CATEGORY_META[tile.id].permalink}>
              <img src={CATEGORY_META[tile.id].icon} alt="" width="40" height="40" loading="lazy" decoding="async" />
              <h3>{tile.label}</h3>
              <p>{tile.blurb}</p>
            </a>
          ))
        }
      </div>
      <p class="section-cta"><a href="/drawing-tutorials/">View all categories and tutorials</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Beginner</p>
        <h2 class="section__title">Easy drawings</h2>
        <p class="section__intro">Shorter sequences with friendly shapes and clear checkpoints.</p>
      </div>
      <div class="easy-row">
        {easy.map((t) => <TutorialCard tutorial={t} showDescription={false} />)}
      </div>
      <p class="section-cta"><a href="/easy-drawings/">See all easy drawings</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Practice</p>
        <h2 class="section__title">Free worksheets</h2>
        <p class="section__intro">
          Printable PDF sheets with step boxes, tracing areas, and blank practice space. Use letter or A4 paper and keep
          graphite pressure light while you practise.
        </p>
      </div>
      <div class="card-grid card-grid--4">
        {
          worksheetSamples.map((t) => (
            <article class="worksheet-card">
              <div class="worksheet-card__media">
                <img
                  src={t.data.worksheet.preview}
                  alt={t.data.worksheet.title}
                  title={t.data.worksheet.title}
                  width="800"
                  height="1056"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="worksheet-card__body">
                <h3 style="font-size:1.05rem;font-weight:700">{t.data.worksheet.title}</h3>
                <div style="display:flex;flex-wrap:wrap;gap:0.5rem">
                  <a class="btn btn--primary btn--sm" href={t.data.worksheet.pdf} download>
                    Download PDF
                  </a>
                  <a class="btn btn--ghost btn--sm" href={t.data.permalink}>
                    Full tutorial
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p class="section-cta"><a href="/worksheets/">Browse all worksheets</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Process</p>
        <h2 class="section__title">How lessons work</h2>
      </div>
      <div class="how-grid">
        <div class="how-card"><div class="how-card__num">1</div><h3>Choose a subject</h3><p>Pick a tutorial from search, categories, or easy drawings.</p></div>
        <div class="how-card"><div class="how-card__num">2</div><h3>Prepare your pencil and paper</h3><p>Gather simple materials before the first construction line.</p></div>
        <div class="how-card"><div class="how-card__num">3</div><h3>Follow each visual step</h3><p>Build from guides to contours with tips at every stage.</p></div>
        <div class="how-card"><div class="how-card__num">4</div><h3>Print a worksheet and practise</h3><p>Repeat the sequence until the shapes feel natural.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Fundamentals</p>
        <h2 class="section__title">Learn drawing basics</h2>
      </div>
      <div class="skill-grid">
        {
          LEARN_GUIDES.filter((g) => ['basic-shapes', 'shading', 'proportions'].includes(g.slug)).map((g) => (
            <a class="skill-card" href={`/learn-drawing/${g.slug}/`}>
              <h3>{g.slug === 'shading' ? 'Pencil Shading' : g.slug === 'proportions' ? 'Drawing Proportions' : g.title}</h3>
              <p>{g.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">New</p>
        <h2 class="section__title">Latest tutorials</h2>
      </div>
      <div class="card-grid">
        {latest.map((t) => <TutorialCard tutorial={t} />)}
      </div>
      <p class="section-cta"><a class="btn btn--secondary" href="/drawing-tutorials/">View all tutorials</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">Drawing lessons designed for clear practice</h2>
      </div>
      <div class="why-grid">
        <div class="why-item"><h3>Structured steps</h3><p>Each lesson moves from construction to contour without skipping checkpoints.</p></div>
        <div class="why-item"><h3>Subject-specific instructions</h3><p>Tips and mistakes stay tied to the subject you are actually drawing.</p></div>
        <div class="why-item"><h3>Printable worksheets</h3><p>Real PDF sheets support tracing, grids, and blank redraws.</p></div>
        <div class="why-item"><h3>Organized categories</h3><p>Browse by subject family instead of hunting through mixed lists.</p></div>
        <div class="why-item"><h3>Mobile-friendly lessons</h3><p>Readable layouts and large touch targets on small screens.</p></div>
        <div class="why-item"><h3>Original educational copy</h3><p>Tutorials written for practice—not recycled filler or tool demos.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="section__header">
        <h2 class="section__title">Homepage FAQs</h2>
      </div>
      <FaqSection faqs={homepageFaqs} />
    </div>
  </section>
</BaseLayout>
