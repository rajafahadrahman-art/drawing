---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/search/SearchPanel.astro';
import TutorialCard from '../components/tutorials/TutorialCard.astro';
import FaqSection from '../components/common/FaqSection.astro';
import { SITE, CATEGORY_META, HOME_CATEGORY_TILES, LEARN_GUIDES } from '../data/site';
import { getCollection } from 'astro:content';
import '../styles/homepage.css';

const tutorials = await getCollection('tutorials', ({ data }) => !data.draft);
const popularSlugs = [
  'flower-drawing',
  'cat-drawing',
  'butterfly-drawing',
  'dog-drawing',
  'rose-drawing',
];
const popular = popularSlugs.map((slug) => tutorials.find((t) => t.data.slug === slug)).filter(Boolean);
const featured = popular[0];
const featuredSupport = popular.slice(1, 5);
const latest = [...tutorials].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0, 6);
const previewA = tutorials.find((t) => t.data.slug === 'rose-drawing') || tutorials[0];
const previewB = tutorials.find((t) => t.data.slug === 'cat-drawing') || tutorials[1];
const previewC = tutorials.find((t) => t.data.slug === 'butterfly-drawing') || tutorials[2];

const homepageFaqs = [
  {
    question: 'What kind of drawing lessons does Drawinging offer?',
    answer:
      'Drawinging publishes step-by-step drawing tutorials organized by category, with beginner-friendly lessons, printable worksheets, and clear construction guidance.',
  },
  {
    question: 'Do I need special art supplies?',
    answer:
      'Most lessons only need pencil, eraser, and paper. Some tutorials suggest optional colored pencils or markers once the line drawing is complete.',
  },
  {
    question: 'Are the worksheets free to download?',
    answer:
      'Yes. Priority tutorials include free PDF and SVG practice worksheets you can print and reuse.',
  },
  {
    question: 'How should beginners start?',
    answer:
      'Begin with Easy Drawings or a fundamentals guide such as basic shapes, then practise one subject tutorial with its worksheet.',
  },
  {
    question: 'Is Drawinging an online drawing tool?',
    answer:
      'No. Drawinging is an educational content site focused on tutorials, categories, and printable practice sheets—not a canvas or drawing app.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.domain,
    logo: `${SITE.domain}/brand/logo.svg`,
    email: SITE.email,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.domain,
    description: SITE.description,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${SITE.domain}/search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
];

const chips = [
  { label: 'Rose', href: '/rose-drawing/' },
  { label: 'Cat', href: '/cat-drawing/' },
  { label: 'Butterfly', href: '/butterfly-drawing/' },
  { label: 'Car', href: '/car-drawing/' },
  { label: 'Heart', href: '/heart-drawing/' },
];
---

<BaseLayout
  title="Drawinging — Step-by-Step Drawing Tutorials & Worksheets"
  description={SITE.description}
  canonical={`${SITE.domain}/`}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1>Learn to Draw, One Clear Step at a Time</h1>
        <p class="hero__lede">
          Organized drawing tutorials, beginner-friendly lessons, and printable worksheets—so you always know what to
          draw next.
        </p>
        <div class="hero__search">
          <SearchPanel id="home-search" large />
          <div>
            <a class="btn btn--primary" href="/drawing-tutorials/">Explore Tutorials</a>
          </div>
          <div class="hero__chips" aria-label="Popular searches">
            {chips.map((chip) => <a class="chip" href={chip.href}>{chip.label}</a>)}
          </div>
        </div>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="hero-preview">
          <a class="hero-preview__main card-link" href={previewA.data.permalink} style="text-decoration:none">
            <img
              src={previewA.data.featuredImage}
              alt=""
              width="1200"
              height="800"
              fetchpriority="high"
              decoding="async"
            />
            <div class="hero-preview__meta">
              <strong>{previewA.data.title}</strong>
              <span class="meta-row">
                <span class="pill">{previewA.data.difficulty}</span>
                <span>{previewA.data.stepCount} steps</span>
              </span>
            </div>
          </a>
          <div class="hero-preview__row">
            <a class="hero-preview__mini card-link" href={previewB.data.permalink} style="text-decoration:none">
              <img src={previewB.data.featuredImage} alt="" width="600" height="450" loading="lazy" decoding="async" />
            </a>
            <a class="hero-preview__mini card-link" href={previewC.data.permalink} style="text-decoration:none">
              <img src={previewC.data.featuredImage} alt="" width="600" height="450" loading="lazy" decoding="async" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="categories">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Browse</p>
        <h2 class="section__title">What Would You Like to Draw?</h2>
        <p class="section__intro">Pick a subject family and jump into clear, step-by-step lessons.</p>
      </div>
      <div class="cat-grid">
        {
          HOME_CATEGORY_TILES.map((tile) => (
            <a class={`cat-tile cat-tile--${tile.tone}`} href={CATEGORY_META[tile.id].permalink}>
              <img class="cat-tile__icon" src={CATEGORY_META[tile.id].icon} alt="" width="40" height="40" loading="lazy" decoding="async" />
              <h3>{tile.label}</h3>
              <p>{tile.blurb}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Featured</p>
        <h2 class="section__title">Featured tutorials</h2>
        <p class="section__intro">Start with high-demand lessons chosen for clarity and practice value.</p>
      </div>
      <div class="featured-layout">
        <div class="featured-main">
          {featured && <TutorialCard tutorial={featured} featured />}
        </div>
        <div class="featured-side">
          {featuredSupport.map((t) => <TutorialCard tutorial={t} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="skill-levels">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Levels</p>
        <h2 class="section__title">Choose your skill level</h2>
        <p class="section__intro">Match the lesson pace to where you are today.</p>
      </div>
      <div class="skill-grid">
        <a class="skill-card skill-card--mint" href="/easy-drawings/">
          <svg class="skill-card__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M8 12h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <h3>Beginner</h3>
          <p>Simple shapes, short sequences, and friendly checkpoints.</p>
        </a>
        <a class="skill-card skill-card--yellow" href="/drawing-tutorials/">
          <svg class="skill-card__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 16l7-10 7 10H5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
          </svg>
          <h3>Intermediate</h3>
          <p>Better proportions, cleaner contours, and more detail control.</p>
        </a>
        <a class="skill-card skill-card--peach" href="/fantasy-drawings/">
          <svg class="skill-card__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 4l2.2 4.5L19 9.2l-3.5 3.4.8 4.9L12 15.8 7.7 17.5l.8-4.9L5 9.2l4.8-.7L12 4z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
          </svg>
          <h3>Advanced</h3>
          <p>Longer builds for complex subjects like dragons and detailed forms.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--blue" id="drawing-tool">
    <div class="container tool-panel">
      <div class="tool-copy">
        <p class="section__eyebrow">Step-by-step lessons</p>
        <h2 class="section__title">Follow tutorials like a guided drawing tool</h2>
        <p class="section__intro">
          Every lesson walks you through numbered steps with tips, materials, and a printable worksheet—no account or
          canvas required.
        </p>
        <div>
          <a class="btn btn--primary" href="/drawing-tutorials/">Open a tutorial</a>
        </div>
      </div>
      <div class="tool-preview" aria-hidden="true">
        <div class="tool-preview__toolbar">
          <div class="tool-preview__controls">
            <span class="tool-chip">Previous step</span>
            <span class="tool-chip">Next step</span>
          </div>
          <span class="tool-chip">Step 3 of 7</span>
        </div>
        <div class="tool-preview__stage">
          <div>
            <strong>Preview canvas</strong>
            Static lesson viewer — open any tutorial to follow real steps.
          </div>
        </div>
        <div class="tool-preview__controls">
          <span class="tool-chip">Zoom</span>
          <span class="tool-chip">Difficulty: Beginner</span>
          <span class="tool-chip">Restart</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Practice</p>
        <h2 class="section__title">Free worksheets</h2>
        <p class="section__intro">Printable PDF practice sheets paired with priority tutorials.</p>
      </div>
      <div class="card-grid card-grid--4">
        {
          popular.slice(0, 4).map((t) => (
            <article class="worksheet-card">
              <div class="worksheet-card__media">
                <img
                  src={t.data.worksheet.preview}
                  alt={t.data.worksheet.title}
                  title={t.data.worksheet.title}
                  width="800"
                  height="1056"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="worksheet-card__body">
                <h3 style="font-size:1.05rem;font-weight:600">{t.data.worksheet.title}</h3>
                <div class="worksheet-actions" style="display:flex;flex-wrap:wrap;gap:0.5rem">
                  <a class="btn btn--primary btn--sm" href={t.data.worksheet.pdf} download>
                    Download PDF
                  </a>
                  <a class="btn btn--ghost btn--sm" href={t.data.permalink}>
                    Tutorial
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p class="section-cta"><a href="/worksheets/">Browse all worksheets</a></p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Skills</p>
        <h2 class="section__title">Learn drawing</h2>
        <p class="section__intro">Foundational guides that support every tutorial on the site.</p>
      </div>
      <div class="card-grid">
        {
          LEARN_GUIDES.map((g) => (
            <a class="skill-card skill-card--mint card-link" href={`/learn-drawing/${g.slug}/`} style="text-decoration:none">
              <h3>{g.title}</h3>
              <p>{g.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">New</p>
        <h2 class="section__title">Latest guides</h2>
      </div>
      <div class="card-grid">
        {latest.map((t) => <TutorialCard tutorial={t} />)}
      </div>
      <p class="section-cta">
        <a class="btn btn--secondary" href="/drawing-tutorials/">View all tutorials</a>
      </p>
    </div>
  </section>

  <section class="section section--mint">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Why Drawinging</p>
        <h2 class="section__title">Clear lessons for calm practice</h2>
      </div>
      <div class="why-grid">
        <div class="why-item"><h3>Clear step sequences</h3><p>Lessons move from construction to contour without skipping checkpoints.</p></div>
        <div class="why-item"><h3>Beginner-friendly explanations</h3><p>Plain language focused on what to draw next and why it matters.</p></div>
        <div class="why-item"><h3>Printable practice sheets</h3><p>Real PDF worksheets for tracing, grids, and blank redraws.</p></div>
        <div class="why-item"><h3>Organized categories</h3><p>Browse by subject family instead of hunting through mixed lists.</p></div>
        <div class="why-item"><h3>Mobile-friendly lessons</h3><p>Readable layouts and large touch targets on small screens.</p></div>
        <div class="why-item"><h3>Original educational content</h3><p>Tutorials written for practice—not recycled filler or tool demos.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="section__header">
        <h2 class="section__title">Homepage FAQs</h2>
      </div>
      <FaqSection faqs={homepageFaqs} />
    </div>
  </section>
</BaseLayout>
