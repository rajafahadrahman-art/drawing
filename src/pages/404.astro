---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Page not found | Drawinging"
  description="The page you requested could not be found."
  canonical={`${SITE.domain}/404/`}
  noindex={true}
>
  <div class="container section" style="text-align:center;max-width:36rem;margin-inline:auto">
    <h1>Page not found</h1>
    <p style="margin:1rem 0 1.5rem">
      That URL is missing or outdated. Try search, browse tutorials, or return home.
    </p>
    <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap">
      <a class="btn btn--primary" href="/">Home</a>
      <a class="btn btn--secondary" href="/drawing-tutorials/">Drawing tutorials</a>
      <a class="btn btn--ghost" href="/search/">Search</a>
    </div>
  </div>
</BaseLayout>
