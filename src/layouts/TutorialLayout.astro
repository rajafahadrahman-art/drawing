---
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import TutorialSummary from '../components/tutorials/TutorialSummary.astro';
import TutorialSteps from '../components/tutorials/TutorialSteps.astro';
import WorksheetBlock from '../components/worksheets/WorksheetBlock.astro';
import RelatedTutorials from '../components/tutorials/RelatedTutorials.astro';
import FaqSection from '../components/common/FaqSection.astro';
import { SITE, CATEGORY_META } from '../data/site';
import { getCollection } from 'astro:content';
import '../styles/tutorials.css';

interface Props {
  tutorial: any;
}

const { tutorial } = Astro.props;
const data = tutorial.data;
const category = CATEGORY_META[data.category];
const all = await getCollection('tutorials', ({ data }) => !data.draft);
const related = all.filter((t) => data.relatedTutorials.includes(t.data.slug));
const { Content, headings = [] } = await render(tutorial);
const useBody = Boolean(data.useArticleBody);

const tocItems = [
  { href: '#overview', label: 'Overview' },
  { href: '#materials', label: 'Materials' },
  { href: '#before-you-start', label: 'Before you start' },
  { href: '#steps', label: 'Step-by-step tutorial' },
  { href: '#refine', label: 'Refine the drawing' },
  ...(data.shading ? [{ href: '#shading', label: 'Shading or coloring' }] : []),
  { href: '#beginner-variation', label: 'Beginner variation' },
  ...(data.detailedVariation ? [{ href: '#detailed-variation', label: 'Detailed variation' }] : []),
  { href: '#mistakes', label: 'Common mistakes' },
  { href: '#tips', label: 'Drawing tips' },
  { href: '#worksheet', label: 'Worksheet' },
  { href: '#related', label: 'Related tutorials' },
  { href: '#faqs', label: 'FAQs' },
];

const bodyToc = headings
  .filter((heading: any) => heading.depth === 2)
  .map((heading: any) => ({ href: `#${heading.slug}`, label: heading.text }));

const activeToc = useBody ? bodyToc : tocItems;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: data.title,
    description: data.description,
    url: data.canonicalURL,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.domain },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.h1,
    description: data.description,
    datePublished: data.publishedAt.toISOString(),
    dateModified: data.updatedAt.toISOString(),
    author: { '@type': 'Organization', name: data.author },
    image: [`${SITE.domain}${data.featuredImage}`],
    mainEntityOfPage: data.canonicalURL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain + '/' },
      {
        '@type': 'ListItem',
        position: 2,
        name: category?.name || 'Tutorials',
        item: SITE.domain + (category?.permalink || '/drawing-tutorials/'),
      },
      { '@type': 'ListItem', position: 3, name: data.h1, item: data.canonicalURL },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: data.h1,
    description: data.description,
    totalTime: `PT${parseInt(String(data.estimatedTime).replace(/[^\d].*$/, ''), 10) || 25}M`,
    estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
    supply: data.materials.map((m: string) => ({ '@type': 'HowToSupply', name: m })),
    step: data.steps.map((step: any, i: number) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: step.title,
      text: step.body,
      image: `${SITE.domain}${data.stepImages[i]?.src || data.featuredImage}`,
      url: `${data.canonicalURL}#step-${i + 1}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faqs.map((f: any) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout
  title={data.metaTitle}
  description={data.description}
  canonical={data.canonicalURL}
  ogImage={`${SITE.domain}${data.featuredImage.replace('.webp', '-og.webp')}`}
  ogType="article"
  noindex={data.noindex}
  jsonLd={jsonLd}
>
  <div class="tutorial-shell">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: category?.name || 'Tutorials', href: category?.permalink || '/drawing-tutorials/' },
        { label: data.focusKeyword },
      ]}
    />

    <div class="tutorial-layout">
      <article class="tutorial-main">
        <header class="tutorial-hero">
          <span class="category-badge">{category?.name}</span>
          <h1>{data.h1}</h1>
          <p>{data.intro}</p>
          <p class="editorial-meta">
            <span>By {data.author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={data.updatedAt.toISOString()}>
              Updated {data.updatedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </p>
          <TutorialSummary
            difficulty={data.difficulty}
            estimatedTime={data.estimatedTime}
            stepCount={data.stepCount}
            materials={data.materials}
            medium={data.medium}
            hasWorksheet={true}
          />
          {
            !useBody && (
              <figure class="step__media">
                <img
                  src={data.featuredImage}
                  alt={data.featuredImageAlt}
                  title={data.featuredImageTitle}
                  width={data.featuredImageWidth}
                  height={data.featuredImageHeight}
                  fetchpriority="high"
                  decoding="async"
                />
              </figure>
            )
          }
        </header>

        <nav class="toc toc-mobile sidebar-card" aria-label="Table of contents">
          <details>
            <summary>On this page</summary>
            <ol>
              {activeToc.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ol>
          </details>
        </nav>

        {
          useBody ? (
            <div class="article-body prose">
              <Content />
              <div style="margin-top:1.25rem">
                <button class="btn btn--secondary btn--block" type="button" data-print-worksheet data-preview={data.worksheet.preview}>
                  Print worksheet preview
                </button>
              </div>
            </div>
          ) : (
            <div class="prose">
              <section id="materials" class="materials-card">
                <h2>Materials needed</h2>
                <ul>
                  {data.materials.map((item: string) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>

              <section id="before-you-start">
                <h2>Before you start</h2>
                <p>{data.beforeYouStart}</p>
              </section>

              <section id="steps">
                <h2>Step-by-step tutorial</h2>
                <TutorialSteps steps={data.steps} images={data.stepImages} focusKeyword={data.focusKeyword} />
              </section>

              <section id="refine">
                <h2>Refine the drawing</h2>
                <p>{data.refine}</p>
              </section>

              {data.shading && (
                <section id="shading">
                  <h2>Shading or coloring</h2>
                  <p>{data.shading}</p>
                </section>
              )}

              <section id="beginner-variation">
                <h2>Beginner variation</h2>
                <p>{data.beginnerVariation}</p>
              </section>

              {data.detailedVariation && (
                <section id="detailed-variation">
                  <h2>Detailed variation</h2>
                  <p>{data.detailedVariation}</p>
                </section>
              )}

              <section id="mistakes" class="mistakes-card">
                <h2>Common mistakes</h2>
                <ul>
                  {data.commonMistakes.map((m: string) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </section>

              <section id="tips">
                <h2>Drawing tips</h2>
                <ul>
                  {data.tips.map((t: string) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </section>

              <section id="worksheet">
                <h2>Practice worksheet</h2>
                <WorksheetBlock worksheet={data.worksheet} tutorialSlug={data.slug} />
              </section>

              <p>
                Explore more <a href={category?.permalink}>{category?.name.toLowerCase() || 'drawing tutorials'}</a> or
                practise fundamentals in our{' '}
                <a href={`/learn-drawing/${data.relatedGuides[0] || 'basic-shapes'}/`}>drawing skills guides</a>.
              </p>

              <section id="related">
                <h2>Related tutorials</h2>
                <RelatedTutorials tutorials={related} />
              </section>

              <section id="faqs">
                <h2>FAQs</h2>
                <FaqSection faqs={data.faqs} />
              </section>

              <section>
                <h2>Conclusion</h2>
                <p>{data.conclusion}</p>
              </section>
            </div>
          )
        }

        {
          useBody && (
            <section id="related-cards" style="margin-top:2rem">
              <h2>Keep practising</h2>
              <RelatedTutorials tutorials={related} />
            </section>
          )
        }
      </article>

      <aside class="tutorial-sidebar" aria-label="Tutorial sidebar">
        <nav class="toc toc-desktop sidebar-card" aria-label="Table of contents">
          <h2>On this page</h2>
          <ol>
            {activeToc.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ol>
        </nav>
        <div class="sidebar-card">
          <h2>Worksheet</h2>
          <p style="margin-bottom:0.85rem;font-size:0.92rem">Download the printable practice sheet for this lesson.</p>
          <a class="btn btn--primary btn--block" href={data.worksheet.pdf} download>
            Download PDF
          </a>
          <a class="btn btn--ghost btn--block" style="margin-top:0.5rem" href={data.worksheet.svg} download>
            Download SVG
          </a>
        </div>
        <div class="sidebar-card">
          <h2>Category</h2>
          <p style="margin-bottom:0.75rem;font-size:0.92rem">
            Explore more {category?.name.toLowerCase() || 'tutorials'}.
          </p>
          <a class="btn btn--secondary btn--block" href={category?.permalink || '/drawing-tutorials/'}>
            {category?.name || 'All tutorials'}
          </a>
        </div>
      </aside>
    </div>
  </div>
  <script>
    document.querySelectorAll('[data-print-worksheet]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-preview');
        if (!src) return;
        const win = window.open('', '_blank');
        if (!win) return;
        win.document.write(
          `<html><head><title>Print worksheet</title></head><body style="margin:0;display:grid;place-items:center"><img src="${src}" style="max-width:100%;height:auto" onload="window.print()" /></body></html>`
        );
        win.document.close();
      });
    });
  </script>
</BaseLayout>
