---
import { CATEGORY_META, LEARN_GUIDES } from '../../data/site';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorials', ({ data }) => !data.draft))
  .sort((a, b) => a.data.focusKeyword.localeCompare(b.data.focusKeyword))
  .slice(0, 8);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h2>Popular tutorials</h2>
        <ul>
          {tutorials.map((t) => <li><a href={t.data.permalink}>{t.data.focusKeyword}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Categories</h2>
        <ul>
          {Object.values(CATEGORY_META).map((c) => <li><a href={c.permalink}>{c.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Resources</h2>
        <ul>
          <li><a href="/worksheets/">Worksheets</a></li>
          <li><a href="/easy-drawings/">Easy drawings</a></li>
          <li><a href="/drawing-tutorials/">All tutorials</a></li>
          <li><a href="/learn-drawing/">Learn drawing</a></li>
          {LEARN_GUIDES.slice(0, 3).map((g) => (
            <li>
              <a href={`/learn-drawing/${g.slug}/`}>{g.title}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>About</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/editorial-policy/">Editorial policy</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/privacy-policy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
          <li><a href="/sitemap/">HTML sitemap</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {year} Drawinging. Educational drawing tutorials and worksheets.</p>
      <p><a href="https://drawinging.com/">drawinging.com</a></p>
    </div>
  </div>
</footer>
