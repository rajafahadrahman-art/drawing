---
const path = Astro.url.pathname;

const popular = [
  { label: 'Flower Drawing', href: '/flower-drawing/' },
  { label: 'Rose Drawing', href: '/rose-drawing/' },
  { label: 'Cat Drawing', href: '/cat-drawing/' },
  { label: 'Dog Drawing', href: '/dog-drawing/' },
  { label: 'Butterfly Drawing', href: '/butterfly-drawing/' },
  { label: 'Tree Drawing', href: '/tree-drawing/' },
];

const categories = [
  { label: 'Flower Drawings', href: '/flower-drawings/' },
  { label: 'Animal Drawings', href: '/animal-drawings/' },
  { label: 'Bird Drawings', href: '/bird-drawings/' },
  { label: 'Insect Drawings', href: '/insect-drawings/' },
  { label: 'Sea Animal Drawings', href: '/sea-animal-drawings/' },
  { label: 'Nature Drawings', href: '/nature-drawings/' },
  { label: 'Vehicle Drawings', href: '/vehicle-drawings/' },
  { label: 'Sports Drawings', href: '/sports-drawings/' },
  { label: 'Seasonal Drawings', href: '/seasonal-drawings/' },
  { label: 'Fantasy Drawings', href: '/fantasy-drawings/' },
  { label: 'Symbol Drawings', href: '/symbol-drawings/' },
];

const learning = [
  { label: 'Basic Shapes', href: '/learn-drawing/basic-shapes/' },
  { label: 'Line Control', href: '/learn-drawing/line-control/' },
  { label: 'Pencil Shading', href: '/learn-drawing/shading/' },
  { label: 'Drawing Proportions', href: '/learn-drawing/proportions/' },
  { label: 'Perspective Basics', href: '/learn-drawing/perspective/' },
];

const primary = [
  { label: 'Tutorials', href: '/drawing-tutorials/' },
  { label: 'Categories', href: '/#categories', mega: true },
  { label: 'Easy Drawings', href: '/easy-drawings/' },
  { label: 'Worksheets', href: '/worksheets/' },
  { label: 'Learn Drawing', href: '/learn-drawing/' },
];
---

<div class="utility-bar">Free Drawing Tutorials and Printable Worksheets</div>

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Drawinging home">
      <img src="/brand/logo-mark.svg" alt="" width="32" height="32" />
      <span>Drawinging</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {
        primary.map((item) =>
          item.mega ? (
            <div class="nav-item">
              <a class="nav-link" href="/#categories" aria-haspopup="true" aria-expanded="false">
                {item.label}
              </a>
              <div class="mega-menu" role="menu" aria-label="Categories mega menu">
                <div class="mega-col">
                  <h3>Popular Tutorials</h3>
                  {popular.map((link) => (
                    <a class="mega-link" role="menuitem" href={link.href}>
                      {link.label}
                    </a>
                  ))}
                </div>
                <div class="mega-col">
                  <h3>Categories</h3>
                  {categories.map((link) => (
                    <a class="mega-link" role="menuitem" href={link.href}>
                      {link.label}
                    </a>
                  ))}
                </div>
                <div class="mega-col">
                  <h3>Learning Resources</h3>
                  {learning.map((link) => (
                    <a class="mega-link" role="menuitem" href={link.href}>
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              class="nav-link"
              href={item.href}
              aria-current={path === item.href || (item.href !== '/' && !item.href.includes('#') && path.startsWith(item.href)) ? 'page' : undefined}
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <div class="header-actions">
      <a class="btn btn--ghost btn--sm" href="/search/" aria-label="Search tutorials">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M16.5 16.5L20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        Search
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <span class="sr-only">Open menu</span>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" data-open="false" hidden>
  <div class="mobile-nav__backdrop" data-menu-close></div>
  <nav class="mobile-nav__panel" aria-label="Mobile">
    <button class="btn btn--ghost" type="button" data-menu-close>Close</button>
    {primary.filter((i) => !i.mega).map((item) => <a href={item.href}>{item.label}</a>)}
    <a href="/search/">Search</a>
    <details>
      <summary>Categories</summary>
      {categories.map((link) => <a href={link.href}>{link.label}</a>)}
    </details>
    <details>
      <summary>Popular Tutorials</summary>
      {popular.map((link) => <a href={link.href}>{link.label}</a>)}
    </details>
    <details>
      <summary>Learning Resources</summary>
      {learning.map((link) => <a href={link.href}>{link.label}</a>)}
    </details>
  </nav>
</div>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const drawer = document.querySelector('#mobile-nav');
  const openDrawer = () => {
    if (!drawer || !toggle) return;
    drawer.hidden = false;
    drawer.setAttribute('data-open', 'true');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const closeDrawer = () => {
    if (!drawer || !toggle) return;
    drawer.setAttribute('data-open', 'false');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    window.setTimeout(() => {
      drawer.hidden = true;
    }, 200);
  };
  toggle?.addEventListener('click', openDrawer);
  drawer?.querySelectorAll('[data-menu-close]').forEach((el) => el.addEventListener('click', closeDrawer));
  drawer?.querySelectorAll('a').forEach((el) => el.addEventListener('click', closeDrawer));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });
</script>
