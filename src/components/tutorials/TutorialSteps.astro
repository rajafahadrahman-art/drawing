---
interface Props {
  steps: { title: string; body: string; tip: string }[];
  images: { src: string; alt: string; title: string; width: number; height: number }[];
  focusKeyword: string;
}
const { steps, images } = Astro.props;
---

<div class="steps-list">
  {
    steps.map((step, index) => {
      const image = images[index];
      const prev = index > 0 ? `#step-${index}` : null;
      const next = index < steps.length - 1 ? `#step-${index + 2}` : null;
      return (
        <section class="step" id={`step-${index + 1}`}>
          <h3>
            Step {index + 1}: {step.title}
          </h3>
          <p>{step.body}</p>
          {image && (
            <figure class="step__media">
              <img
                src={image.src}
                alt={image.alt}
                title={image.title}
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
              />
            </figure>
          )}
          <p class="step__tip">
            <strong>Tip:</strong> {step.tip}
          </p>
          <div class="step-nav">
            {prev ? (
              <a class="btn btn--ghost btn--sm" href={prev}>
                Previous step
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a class="btn btn--secondary btn--sm" href={next}>
                Next step
              </a>
            ) : (
              <span />
            )}
          </div>
        </section>
      );
    })
  }
</div>
