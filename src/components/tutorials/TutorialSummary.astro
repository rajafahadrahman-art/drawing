---
interface Props {
  difficulty: string;
  estimatedTime: string;
  stepCount: number;
  materials: string[];
  hasWorksheet: boolean;
  medium?: string;
}
const { difficulty, estimatedTime, stepCount, materials, hasWorksheet, medium } = Astro.props;
---

<dl class="summary-box">
  <div>
    <dt>Difficulty</dt>
    <dd>{difficulty}</dd>
  </div>
  <div>
    <dt>Time</dt>
    <dd>{estimatedTime}</dd>
  </div>
  <div>
    <dt>Steps</dt>
    <dd>{stepCount}</dd>
  </div>
  <div>
    <dt>Medium</dt>
    <dd>{medium || materials[0] || 'Pencil'}</dd>
  </div>
  <div>
    <dt>Worksheet</dt>
    <dd>{hasWorksheet ? 'Free printable PDF' : 'Not available'}</dd>
  </div>
</dl>
